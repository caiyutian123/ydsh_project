# ============================================================
# 云购生活数仓项目 .gitignore
# ============================================================

# ---- 数据文件（过大，不纳入版本库） ----
data/*.csv
*.csv

# ---- 密钥与配置 ----
.env
*.key
*.pem

# ---- 日志与临时文件 ----
*.log
__pycache__/
node_modules/
.DS_Store

# ---- Hive 运行数据（本地文件系统） ----
hive-data/

# ---- docs 目录下的排障临时文件 ----
docs/*.txt
docs/*.ps1
docs/*.png
!docs/运行验证截图.png
docs/*.json
